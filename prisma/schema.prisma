generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name         String?
  image        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  portfolios   Portfolio[]
  jobPosts     JobPost[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires     DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token     String   @unique
  expires   DateTime

  @@unique([identifier, token])
}

model JobPost {
  id          String           @id @default(cuid())
  userId      String
  url         String?
  content     String          @db.Text
  analysis    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   MatchedProduct[]
  portfolios Portfolio[]

  @@index([userId])
}

model MatchedProduct {
  id              String       @id @default(cuid())
  jobPostId        String
  url             String
  name            String?
  description     String?      @db.Text
  features        Json?
  similarityScore Float?
  createdAt       DateTime     @default(now())
  jobPost         JobPost     @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  screenshots    Screenshot[]

  @@index([jobPostId])
}

model Screenshot {
  id                String             @id @default(cuid())
  matchedProductId    String
  url               String
  imagePath         String?
  featureTags       String[]
  createdAt         DateTime           @default(now())
  matchedProduct   MatchedProduct    @relation(fields: [matchedProductId], references: [id], onDelete: Cascade)
  descriptions     GeneratedDescription[]
}

model GeneratedDescription {
  id                   String     @id @default(cuid())
  screenshotId         String
  shortDescription     String?    @db.Text
  mediumDescription   String?    @db.Text
  enterpriseDescription String?   @db.Text
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  screenshot         Screenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)

  @@index([screenshotId])
}

model Portfolio {
  id          String   @id @default(cuid())
  userId       String
  jobPostId    String?
  title       String?
  template    String   @default("modern-saas")
  theme       String   @default("dark")
  sections    Json     @default("[]")
  pdfPath     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPost     JobPost? @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobPostId])
}